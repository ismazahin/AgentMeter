 "components": {
  "securitySchemes": {
   "userToken": {
    "type": "http",
    "scheme": "bearer",
    "description": "Access token from POST /api/auth/login on the control plane (15 minutes). Scope admin: the user's role must be admin."
   },
   "runToken": {
    "type": "http",
    "scheme": "bearer",
    "description": "Run token from POST /api/runs/authorize on the control plane (5 minutes; single use for actions); its scope is the token's kind. Not needed in one-user mode (no control plane)."
   },
   "backendSignature": {
    "type": "apiKey",
    "in": "header",
    "name": "X-AM-Signature",
    "description": "hex HMAC-SHA256(BACKEND_SECRET, method\\npath\\nX-AM-Timestamp\\nsha256(body)); X-AM-Timestamp (unix seconds) within 120 s."
   },
   "prepSignature": {
    "type": "apiKey",
    "in": "header",
    "name": "X-AM-Signature",
    "description": "The same signature with CLOUD_PREP_SECRET (preparation service → control plane)."
   },
   "controlPlaneSignature": {
    "type": "apiKey",
    "in": "header",
    "name": "X-AM-Signature",
    "description": "The same signature with CLOUD_PREP_SECRET (control plane → preparation service)."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "string",
      "description": "A sentence for people"
     },
     "code": {
      "type": "string",
      "description": "A stable code for programs"
     }
    }
   }
  }
 }
