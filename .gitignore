# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Results / artifacts
results/
*.db
*.sqlite
# A real/served analysis.json dropped next to the dashboard for auto-load
# (dashboard/sample_analysis.json is the committed sample and stays tracked).
dashboard/analysis.json

# Config builder output (Phase 18) — user-generated run configs. Keep the
# directory (.gitkeep) but not the generated configs.
configs/user/*.yaml

# HF / model caches
.cache/
hf_cache/
*.safetensors
*.bin

# Secrets — NEVER commit a token. .env.example is the committed placeholder.
.env
.env.local
.env.*.local
*.token

# OS / editor
.DS_Store
.idea/
.vscode/

# Generated outputs that belong under results/, never at the repo root
/pilot_report.html
/model_vram.json
*.worker_vram.json

# control plane (Supabase): local dev data, Supabase CLI state, Deno lock files
controlplane/.dev-data/
supabase/.temp/
supabase/.branches/
supabase/functions/**/deno.lock

# npm packages (any folder)
node_modules/

# IDS models trained on your dataset (scripts/train_ids.py): copy them to the GPU server, do not
# commit them. The tiny demo model (trained on the bundled 300 flows) is tracked.
models/ids/*
!models/ids/demo_ids.*

# Full datasets (large): read from here by scripts/train_ids.py and build-dataset, never committed
data/cicids2017_corrected/
data/cicids_raw/
# Full CIC-IDS2017 PCAP / CSV downloads placed directly in data/ (large). The small bundled
# samples live in data/sample_csv/ and data/sample_pcaps/ and stay tracked.
/data/*.pcap
/data/*.pcapng

# the local preparation service's signing secret (scripts/prep_local.py)
.cloudprep_secret
cloudflared.exe
/cloudflared
