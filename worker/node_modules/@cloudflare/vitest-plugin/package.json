{
  "name": "@cloudflare/vitest-plugin",
  "version": "1.4.0",
  "description": "Workers Vitest integration for writing Vitest unit and integration tests that run inside the Workers runtime",
  "keywords": [
    "cloudflare",
    "environment",
    "integration",
    "jest",
    "miniflare",
    "pool",
    "test",
    "unit",
    "vitest",
    "worker",
    "workers"
  ],
  "homepage": "https://github.com/cloudflare/workers-sdk/tree/main/packages/vitest-plugin#readme",
  "bugs": {
    "url": "https://github.com/cloudflare/workers-sdk/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudflare/workers-sdk.git",
    "directory": "packages/vitest-plugin"
  },
  "files": [
    "dist",
    "types/cloudflare-test.d.ts"
  ],
  "type": "module",
  "main": "dist/pool/index.mjs",
  "types": "dist/pool/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/pool/index.d.mts",
      "import": "./dist/pool/index.mjs"
    },
    "./types": {
      "types": "./types/cloudflare-test.d.ts"
    }
  },
  "dependencies": {
    "cjs-module-lexer": "1.2.3",
    "esbuild": "0.28.2",
    "zod": "4.6.5",
    "miniflare": "5.20261006.1-alpha",
    "wrangler": "4.149.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "22.15.17",
    "@types/semver": "^7.5.1",
    "@vitest/ui": "5.0.3",
    "birpc": "0.2.14",
    "capnp-es": "0.0.16",
    "devalue": "^5.6.3",
    "es-module-lexer": "2.3.1",
    "get-port": "^7.1.0",
    "semver": "^7.7.1",
    "tree-kill": "1.2.2",
    "ts-dedent": "^2.2.0",
    "tsdown": "0.16.3",
    "typescript": "5.8.3",
    "undici": "7.29.1",
    "vitest": "5.0.3",
    "@cloudflare/config": "0.24.1",
    "@cloudflare/remote-bindings": "0.0.45",
    "@cloudflare/mock-npm-registry": "0.0.0",
    "@cloudflare/runtime-types": "0.1.9",
    "@cloudflare/workers-tsconfig": "0.0.0",
    "@cloudflare/workers-utils": "0.47.1",
    "@cloudflare/workflows-shared": "0.15.1"
  },
  "peerDependencies": {
    "vitest": "^4.1.0 || ^5.0.0"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "workers-sdk": {
    "prerelease": true
  },
  "scripts": {
    "build": "tsdown",
    "capnp:rtti": "capnp-es scripts/rtti/rtti.capnp -ojs",
    "check:type": "tsc && tsc -p src/worker/tsconfig.json && tsc -p types/tsconfig.json",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:ci": "vitest run"
  }
}