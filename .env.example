# AgentMeter — token template. Copy to .env and fill in; NEVER commit the real .env.
#
#   cp .env.example .env    &&    edit .env
#
# .env (and .env.local) are gitignored. The server + tooling read these from the
# environment automatically (scripts/pull_eval_server.py loads .env on startup).
# Leave a slot EMPTY if you don't need it — nothing here is required for the
# locked 5-model study, which uses PUBLIC models and needs no token.

# Hugging Face token. OPTIONAL — needed ONLY to pull GATED or PRIVATE models
# (e.g. Llama/Gemma). Public models (including the canonical 5) need none.
HF_TOKEN=

# Vast.ai API key. OPTIONAL — needed only for the server's cost-safety
# self-destroy (--auto-destroy / --idle-timeout). Without it, self-destroy no-ops.
VAST_API_KEY=

# This Vast.ai instance's id, for self-destroy. OPTIONAL — if unset, the server
# falls back to Vast's own env vars (VAST_CONTAINERLABEL, etc.) when present.
VAST_INSTANCE_ID=

# GitHub token. OPTIONAL — only if the Vast box must `git clone` a PRIVATE repo.
# Not wired into anything automatic; documented for manual clones only.
GITHUB_TOKEN=
