# AgentMeter — token template. Copy to .env and fill in; NEVER commit the real .env.
#
#   cp .env.example .env    &&    edit .env
#
# .env (and .env.local) are gitignored. The server + tooling read these from the
# environment automatically (scripts/pull_eval_server.py loads .env on startup).
# Leave a slot EMPTY if you don't need it — nothing here is required for the
# locked 5-model study, which uses PUBLIC models and needs no token.

# Hugging Face token. Needed to download GATED models: two of the canonical 5 are
# gated (meta-llama/Meta-Llama-3-8B-Instruct, google/gemma-2-9b-it) — accept their
# licences on huggingface.co with the account that owns this token. scripts/vast_up.sh
# requires it. Only reading the locked study's existing results needs none.
HF_TOKEN=

# Vast.ai API key. OPTIONAL — needed only for the server's cost-safety
# self-destroy (--auto-destroy / --idle-timeout). Without it, self-destroy no-ops.
VAST_API_KEY=

# This Vast.ai instance's id, for self-destroy. OPTIONAL — if unset, the server
# falls back to Vast's own env vars (VAST_CONTAINERLABEL, etc.) when present.
VAST_INSTANCE_ID=

# GitHub token. OPTIONAL — only if the Vast box must `git clone` a PRIVATE repo.
# Not wired into anything automatic; documented for manual clones only.
GITHUB_TOKEN=

# --- Remote runner (Phase 29) -------------------------------------------------
# Run the benchmark on a Vast.ai / SSH GPU box you have ALREADY rented. Set these
# and the dashboard's "Remote runner" buttons generate a double-click script that
# SSHes in, runs run-full there, and copies the results back to results/ (shown in
# Local results). Only the PATH to your key is used — the key's contents and
# VAST_API_KEY are NEVER written into the downloaded script. Edits here are picked
# up live (no server restart). HOST + PORT are required; the rest have defaults.
VAST_SSH_HOST=
VAST_SSH_PORT=
VAST_SSH_USER=root
# Path to your PRIVATE SSH key on THIS machine (optional if ssh-agent/default key).
VAST_SSH_KEY=
# Where AgentMeter lives on the box (default ~/AgentMeter).
VAST_REMOTE_DIR=~/AgentMeter

# --- Telegram notifications (Phase 30) ----------------------------------------
# Get a push on your phone when a new analysis appears under results/ (after a run
# auto-analyzes, or after a remote run copies results back). Create a bot with
# @BotFather for the token; message the bot once, then open
# https://api.telegram.org/bot<token>/getUpdates to find your chat id. Both must be
# set or notifications are a silent no-op. The token value is never logged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Access control for internet exposure (Phase 31) --------------------------
# Set a password to require HTTP Basic Auth on the WHOLE server (dashboard + API).
# REQUIRED before you expose the server publicly (ngrok / reverse proxy / Cloudflare)
# — without it, anyone with the URL can read results and trigger /pull-eval (which
# spends GPU money). Leave blank for local-only use. Use over HTTPS only. See
# docs/DEPLOY.md.
# NOTE: with the split front-end (Phase E, Vercel/Cloudflare Pages) leave Basic Auth
# OFF and use AGENTMETER_PASSCODE below — a cross-origin page cannot answer a Basic
# Auth prompt.
AGENTMETER_AUTH_USER=agentmeter
AGENTMETER_AUTH_PASS=

# --- Deployment: static front-end + GPU backend (Phase E) ----------------------
# Access passcode for Prepare/Benchmark (sent by the page as X-AgentMeter-Passcode,
# asked once per browser tab). REQUIRED in real-GPU mode. Use a long passphrase.
AGENTMETER_PASSCODE=
# Front-end origin(s) allowed to call this backend (CORS), comma-separated, exact:
#   https://agentmeter.vercel.app,https://agentmeter.pages.dev
AGENTMETER_ALLOWED_ORIGINS=
# real | mock | auto (default auto: real iff CUDA is visible). Real REFUSES to start
# without a GPU, the 5 models on disk and AGENTMETER_PASSCODE — it never falls back.
AGENTMETER_SERVICE_PROVIDER=
# Job creation limits (per client IP per hour; jobs waiting in the queue).
AGENTMETER_JOBS_PER_HOUR=12
AGENTMETER_MAX_QUEUED_JOBS=4
# Cloudflare named tunnel token (stable hostname). Empty = quick tunnel (random URL).
CF_TUNNEL_TOKEN=
CF_TUNNEL_HOSTNAME=
