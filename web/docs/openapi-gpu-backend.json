      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "run": {
          "type": "string"
         },
         "after_prepare": {
          "type": "string"
         },
         "models": {
          "type": "array",
          "description": "array (1–4)"
         },
         "pipeline": {
          "type": "array",
          "description": "array"
         },
         "load_test": {
          "type": "boolean"
