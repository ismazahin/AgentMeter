{
 "openapi": "3.1.0",
 "info": {
  "title": "AgentMeter API — GPU backend",
  "version": "1.1.0",
  "description": "Data preparation, benchmarks, live progress and the live GPU, on the rented GPU. With a control plane every call needs a run token; in one-user mode (no control plane) the same routes are open and also serve sessions, Compare and the Leaderboard.",
  "license": {
   "name": "See the repository"
  }
 },
 "servers": [
  {
   "url": "{backend}",
   "description": "GPU backend (Flask on the rented GPU): preparation, benchmarks, live GPU and queue",
   "variables": {
    "backend": {
     "default": "https://your-gpu-backend.example"
    }
   }
  }
 ],
 "tags": [
  {
   "name": "GPU backend"
  },
  {
   "name": "New benchmark"
  },
  {
   "name": "Data preparation"
  },
  {
   "name": "Data sets"
  },
  {
   "name": "Benchmarks"
  },
  {
   "name": "GPU & Queue"
  },
  {
   "name": "Sessions"
  },
  {
   "name": "Compare"
  },
  {
   "name": "Admin"
  },
  {
   "name": "Repeatability"
  },
  {
   "name": "Settings"
  }
 ],
 "paths": {
  "/api/compare": {
   "get": {
    "operationId": "get__api_compare",
    "tags": [
     "Compare"
    ],
    "summary": "Two sessions side by side (one-user mode)",
    "security": [
     {
      "runToken": [
       "read"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "OK"
     },
     "401": {
      "description": "Not logged in / bad or missing token or signature",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "a",
      "in": "query",
      "required": true,
      "description": "",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "b",
      "in": "query",
      "required": true,
      "description": "",
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
